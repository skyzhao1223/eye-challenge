{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Eye Challenge",
    "version": "1.0.0",
    "updated": "2026-11-07",
    "note": "三层结构：primitive -> semantic -> component。业务代码只允许引用 semantic / component，禁止直接写十六进制。"
  },

  "color": {
    "primitive": {
      "ink": {
        "900": "#0B0E14",
        "800": "#12161F",
        "700": "#1A2030",
        "600": "#242C3D",
        "500": "#39435A",
        "400": "#5A6785",
        "300": "#8B97B0",
        "200": "#C3CBDB",
        "100": "#EDF1F8"
      },
      "amber": {
        "600": "#E09400",
        "500": "#FFB020",
        "400": "#FFC552",
        "100": "#3A2A00"
      },
      "cyan":   { "500": "#35D0E0", "100": "#08303A" },
      "green":  { "500": "#3DD68C", "100": "#0A2E1E" },
      "red":    { "500": "#FF5A5F", "100": "#3A1214" },
      "purple": { "500": "#9B7BFF", "100": "#1E1636" }
    },

    "semantic": {
      "bg": {
        "base":     { "value": "{color.primitive.ink.900}", "comment": "页面底色" },
        "surface":  { "value": "{color.primitive.ink.800}", "comment": "卡片/面板" },
        "elevated": { "value": "{color.primitive.ink.700}", "comment": "弹层/HUD" },
        "sunken":   { "value": "{color.primitive.ink.600}", "comment": "输入框/凹槽" }
      },
      "border": {
        "subtle":  { "value": "{color.primitive.ink.600}" },
        "default": { "value": "{color.primitive.ink.500}" },
        "strong":  { "value": "{color.primitive.ink.400}" }
      },
      "text": {
        "primary":   { "value": "{color.primitive.ink.100}" },
        "secondary": { "value": "{color.primitive.ink.300}" },
        "muted":     { "value": "{color.primitive.ink.400}" },
        "disabled":  { "value": "{color.primitive.ink.500}" },
        "inverse":   { "value": "{color.primitive.ink.900}" }
      },
      "accent": {
        "default":   { "value": "{color.primitive.amber.500}" },
        "hover":     { "value": "{color.primitive.amber.400}" },
        "pressed":   { "value": "{color.primitive.amber.600}" },
        "onAccent":  { "value": "#1A1200" },
        "subtleBg":  { "value": "{color.primitive.amber.100}" }
      },
      "state": {
        "success":    { "value": "{color.primitive.green.500}" },
        "successBg":  { "value": "{color.primitive.green.100}" },
        "danger":     { "value": "{color.primitive.red.500}" },
        "dangerBg":   { "value": "{color.primitive.red.100}" },
        "warning":    { "value": "{color.primitive.amber.500}" },
        "info":       { "value": "{color.primitive.cyan.500}" },
        "infoBg":     { "value": "{color.primitive.cyan.100}" }
      },
      "focus": { "ring": { "value": "{color.primitive.cyan.500}" } }
    },

    "component": {
      "btn": {
        "primaryBg":       { "value": "{color.semantic.accent.default}" },
        "primaryBgHover":  { "value": "{color.semantic.accent.hover}" },
        "primaryBgActive": { "value": "{color.semantic.accent.pressed}" },
        "primaryFg":       { "value": "{color.semantic.accent.onAccent}" },
        "ghostFg":         { "value": "{color.semantic.text.secondary}" },
        "ghostBgHover":    { "value": "{color.semantic.bg.sunken}" }
      },
      "diff": {
        "foundRing":  { "value": "{color.semantic.state.success}" },
        "missRing":   { "value": "{color.semantic.state.danger}" },
        "hintPulse":  { "value": "{color.semantic.accent.default}" },
        "unfoundGlow":{ "value": "rgba(255,176,32,0.35)" }
      },
      "hud": {
        "bg":      { "value": "rgba(18,22,31,0.82)" },
        "border":  { "value": "rgba(57,67,90,0.6)" },
        "timerOk": { "value": "{color.semantic.text.primary}" },
        "timerWarn": { "value": "{color.semantic.state.warning}" },
        "timerCrit": { "value": "{color.semantic.state.danger}" }
      },
      "overlay": { "scrim": { "value": "rgba(11,14,20,0.72)" } }
    }
  },

  "typography": {
    "fontFamily": {
      "sans":    { "value": "\"PingFang SC\", \"Hiragino Sans GB\", \"Source Han Sans SC\", \"Noto Sans SC\", -apple-system, system-ui, sans-serif" },
      "numeric": { "value": "\"SF Mono\", \"JetBrains Mono\", ui-monospace, Menlo, monospace" }
    },
    "fontWeight": {
      "regular":  { "value": 400 },
      "medium":   { "value": 500 },
      "semibold": { "value": 600 },
      "bold":     { "value": 700 }
    },
    "fontSize": {
      "xs":    { "value": "12px", "lineHeight": "16px" },
      "sm":    { "value": "14px", "lineHeight": "20px" },
      "base":  { "value": "16px", "lineHeight": "24px" },
      "lg":    { "value": "20px", "lineHeight": "28px" },
      "xl":    { "value": "24px", "lineHeight": "32px" },
      "2xl":   { "value": "32px", "lineHeight": "40px" },
      "3xl":   { "value": "40px", "lineHeight": "48px" },
      "timer": { "value": "56px", "lineHeight": "56px", "comment": "倒计时专用，必须 tabular-nums" }
    },
    "letterSpacing": {
      "tight":  { "value": "-0.01em" },
      "normal": { "value": "0" },
      "wide":   { "value": "0.04em" }
    }
  },

  "space": {
    "0":  { "value": "0" },
    "1":  { "value": "2px" },
    "2":  { "value": "4px" },
    "3":  { "value": "8px" },
    "4":  { "value": "12px" },
    "5":  { "value": "16px" },
    "6":  { "value": "20px" },
    "7":  { "value": "24px" },
    "8":  { "value": "32px" },
    "9":  { "value": "40px" },
    "10": { "value": "48px" },
    "11": { "value": "64px" }
  },

  "radius": {
    "none": { "value": "0" },
    "sm":   { "value": "4px" },
    "md":   { "value": "8px" },
    "lg":   { "value": "12px" },
    "xl":   { "value": "16px" },
    "2xl":  { "value": "24px" },
    "full": { "value": "999px" }
  },

  "shadow": {
    "sm":   { "value": "0 1px 2px rgba(0,0,0,0.32)" },
    "md":   { "value": "0 4px 12px rgba(0,0,0,0.38)" },
    "lg":   { "value": "0 12px 32px rgba(0,0,0,0.48)" },
    "glow": { "value": "0 0 24px rgba(255,176,32,0.45)", "comment": "提示高亮光晕" }
  },

  "motion": {
    "duration": {
      "instant": { "value": "80ms" },
      "fast":    { "value": "120ms" },
      "base":    { "value": "200ms" },
      "slow":    { "value": "320ms" },
      "slower":  { "value": "480ms" }
    },
    "easing": {
      "standard": { "value": "cubic-bezier(0.2, 0, 0, 1)" },
      "enter":    { "value": "cubic-bezier(0, 0, 0, 1)" },
      "exit":     { "value": "cubic-bezier(0.4, 0, 1, 1)" },
      "bounce":   { "value": "cubic-bezier(0.34, 1.56, 0.64, 1)" }
    },
    "reduceMotion": {
      "value": "prefers-reduced-motion: reduce 时所有 duration 归零，仅保留 opacity 过渡",
      "comment": "无障碍硬性要求"
    }
  },

  "zIndex": {
    "base":    { "value": 0 },
    "canvas":  { "value": 10 },
    "hud":     { "value": 100 },
    "overlay": { "value": 200 },
    "modal":   { "value": 300 },
    "toast":   { "value": 400 }
  },

  "layout": {
    "touchTargetMin": { "value": "44px", "comment": "移动端最小可点区域，硬性要求" },
    "contentMaxWidth": { "value": "1440px", "comment": "仅作上限；实际宽度由 .ec-stage 的高度约束再做一次 min()，避免大屏只能用 960px" },
    "hudHeight":       { "value": "64px" },
    "safeAreaInset":   { "value": "env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left)" }
  },

  "breakpoint": {
    "sm":  { "value": "480px" },
    "md":  { "value": "768px" },
    "lg":  { "value": "1024px" },
    "xl":  { "value": "1280px" }
  }
}
