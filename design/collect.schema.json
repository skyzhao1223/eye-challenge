{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://eye-challenge.local/schema/collect.schema.json",
  "title": "EyeChallengeCollectLevel",
  "description": "模式二「收纳大挑战」的关卡数据契约。场景里散落一堆物品，顶部按顺序排列若干箱子；把属于当前箱子的物品拖进去，箱子装满消失，换下一个。全部箱子清空即通关。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "mode",
    "schemaVersion",
    "title",
    "status",
    "boxes",
    "items",
    "timeLimit"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^lv-[a-z0-9]{3,16}$" },
    "mode": { "type": "string", "const": "collect" },
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "title": { "type": "string", "minLength": 1, "maxLength": 40 },
    "status": { "type": "string", "enum": ["draft", "review", "published", "archived"] },

    "boxes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "description": "按顺序出现的箱子。只有第一个是当前激活的。",
      "items": { "$ref": "#/definitions/box" }
    },

    "items": {
      "type": "array",
      "minItems": 4,
      "maxItems": 30,
      "description": "场景里散落的物品。",
      "items": { "$ref": "#/definitions/item" }
    },

    "timeLimit": { "type": "integer", "minimum": 20, "maximum": 600 },

    "hints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "count": { "type": "integer", "minimum": 0, "maximum": 10, "default": 3 },
        "cooldownSec": { "type": "integer", "minimum": 0, "maximum": 120, "default": 12 },
        "scorePenaltyPct": { "type": "integer", "minimum": 0, "maximum": 100, "default": 8 }
      }
    },

    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "perItem": { "type": "integer", "minimum": 0, "default": 10 },
        "boxClearBonus": { "type": "integer", "minimum": 0, "default": 30 },
        "perSecondLeft": { "type": "number", "minimum": 0, "default": 2 },
        "wrongPenalty": { "type": "integer", "minimum": 0, "default": 5 },
        "starThresholds": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3
        }
      }
    },

    "scene": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "background": {
          "type": "string",
          "enum": ["table", "floor", "desk", "shelf"],
          "description": "程序化生成的场景底色。接入真素材后改为图片 src。"
        },
        "altText": { "type": "string", "maxLength": 200 }
      }
    },

    "tags": { "type": "array", "items": { "type": "string", "maxLength": 16 }, "maxItems": 8 }
  },

  "definitions": {
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kinds"],
      "properties": {
        "id": { "type": "string", "pattern": "^b[0-9]{1,2}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 8 },
        "kinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string" },
          "description": "这个箱子收哪些种类。同一 kind 只能出现在一个箱子里（校验脚本强校验）。"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "箱子主题色，用于区分。省略则自动分配。"
        }
      }
    },

    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "x", "y", "w"],
      "properties": {
        "id": { "type": "string", "pattern": "^i[0-9]{1,2}$" },
        "kind": { "type": "string", "minLength": 1, "maxLength": 20 },
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "中心点 X 归一化坐标（0..1）。"
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "中心点 Y 归一化坐标（0..1）。"
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0.03,
          "maximum": 0.3,
          "description": "物品宽度，相对场景宽度。太小会点不中，下限受 44px 触控规则约束。"
        },
        "rot": {
          "type": "number",
          "minimum": -180,
          "maximum": 180,
          "description": "旋转角度，制造散落感。"
        },
        "z": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20,
          "description": "叠放层级，值大的压在上面。"
        }
      }
    }
  }
}
